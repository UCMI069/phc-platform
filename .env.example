# ============================================
# GCU Banking Platform — Supabase Configuration
# ============================================
# 1. Go to https://supabase.com and create a new project
# 2. Go to Project Settings > API
# 3. Copy your Project URL and anon/public key below
# 4. Rename this file to .env (or copy values into .env)
# 5. Run all migration files in supabase/migrations/ in the SQL Editor
# ============================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
