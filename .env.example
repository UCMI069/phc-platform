# ============================================
# PHC Platform — Neon Configuration
# ============================================
# 1. Go to https://neon.tech and create a project
# 2. Copy your Data API URL, Auth URL, and credentials below
# 3. Rename this file to .env (or copy values into .env)
# ============================================

# Neon Data API (PostgREST)
VITE_NEON_DATA_API=https://your-endpoint.apirest.region.aws.neon.tech/neondb/rest/v1
VITE_NEON_ANON_KEY=your-anon-key

# Neon Auth
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth

# Neon S3-compatible Storage
VITE_NEON_S3_ENDPOINT=https://your-bucket.storage.region.aws.neon.tech
VITE_NEON_S3_ACCESS_KEY=your-access-key
VITE_NEON_S3_SECRET_KEY=your-secret-key
VITE_NEON_S3_REGION=us-east-2

# Neon PostgreSQL Connection (for server-side use if needed)
DATABASE_URL=postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require
